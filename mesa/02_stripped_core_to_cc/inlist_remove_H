

&star_job

      show_log_description_at_start = .false. 

      load_saved_model = .true.
      load_model_filename = 'after_core_he_burn.mod'
      
      save_model_when_terminate = .true.
      save_model_filename = 'H_removed.mod'
      !required_termination_code_string = 'xa_central_lower_limit'

      steps_to_take_before_terminate = 5
      
      set_initial_cumulative_energy_error = .true.
      new_cumulative_energy_error = 0d0

      ! Removing the H envelope by replacing H with He, as we need a model with no H for the next phase of evolution.
      replace_element = .true.
      chem_name1 = 'h1'
      chem_name2 = 'he4'
      ! replaces chem1 by chem2
      replace_element_nzlo = -1
      replace_element_nzhi = -1

      pgstar_flag = .true.

/ ! end of star_job namelist


&eos
/ ! end of eos namelist

&kap
/ ! end of kap namelist

&controls

! wind

! atmosphere

! rotation

! mlt
! mixing

! timesteps

! mesh

! solver
      use_gold2_tolerances = .false.
      use_gold_tolerances = .false.   

! output
      num_trace_history_values = 2
      trace_history_value_name(1) = 'rel_E_err'
      trace_history_value_name(2) = 'log_rel_run_E_err'
      
      !photo_interval = 10
      !profile_interval = 1
      !history_interval = 1
      terminal_interval = 1

/ ! end of controls namelist



&pgstar

      Grid1_title = 'Stripped_core_to_(Remove_H_env)'

/ ! end of pgstar namelist
