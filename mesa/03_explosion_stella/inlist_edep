
&star_job

  save_model_when_terminate = .true.
  save_model_filename = 'done_with_edep.mod'
  required_termination_code_string = 'max_age'

  load_saved_model = .true.
  load_model_filename = 'ready_for_edep.mod'

  set_initial_model_number = .false.
  initial_model_number = 0

  set_initial_dt = .true.
  seconds_for_initial_dt = 1d-6

  change_initial_RTI_flag = .true.
  new_RTI_flag = .false.

  change_initial_v_flag = .true.
  new_v_flag = .false.

  change_initial_u_flag = .true.
  new_u_flag = .true.

  pgstar_flag = .true.

/ ! end of star_job namelist

&eos
/ ! end of eos namelist

&kap
/ ! end of kap namelist

&controls

  initial_mass = 20
  initial_z = 0.02

  terminal_show_age_units = 'seconds'

  num_trace_history_values = 1
  trace_history_value_name(1) = 'total_energy'

  max_num_profile_models = 1000

  !max_model_number = 5050

  ! inject_until_reach_model_with_total_energy = 0.63d+51
  ! inject_until_reach_model_with_total_energy = 1.26d+51
  inject_until_reach_model_with_total_energy =  2.0d+51
  ! make max_age_in_seconds and total_mass_for_inject_extra_ergs_sec large enough so max logT < 10.3
  !max_age_in_seconds = 0.2d0
  ! max_age_in_seconds = 0.005                        ! For a Stripped progenitor
  max_age_in_seconds = 0.01                           ! For a Stripped progenitor:  Uncomment this line if you are injecting energy mnore than 1.6d51
  !total_mass_for_inject_extra_ergs_sec = 0.2d0     ! (Msun) sets size of region for ``inject_extra_ergs_sec``
  total_mass_for_inject_extra_ergs_sec = 1d-2       !For a Stripped progenitor
  max_timestep = 1d-3
  
  start_time_for_inject_extra_ergs_sec = 0d0
  base_of_inject_extra_ergs_sec = -1d0

  fe_core_infall_limit = 1d+99

  dxdt_nuc_factor = 0
  non_nuc_neu_factor = 0
  eps_nuc_factor = 0

! equation controls

  use_dPrad_dm_form_of_T_gradient_eqn = .true.
  energy_eqn_option = 'dedt'
  
  use_fixed_vsurf_outer_BC = .true.
  fixed_vsurf = 0


! mixing controls

  mixing_length_alpha = 1.9
  !MLT_option = 'none'
  MLT_option = 'Henyey'
  thermohaline_coeff = 0
  okay_to_reduce_gradT_excess = .false.

  mix_factor = 0

! mesh controls

  okay_to_remesh = .true.
  use_split_merge_amr = .true.
  split_merge_amr_log_zoning = .true.
  split_merge_amr_nz_baseline = 1000
  split_merge_amr_MaxLong = 1.5
  split_merge_amr_MaxShort = 2
  split_merge_amr_max_iters = 10


! timestep controls
  
  delta_lgL_He_limit = 0.5
  delta_lgT_cntr_limit = 0.2
  delta_lgRho_cntr_limit = 0.5  

  dX_nuc_drop_limit_at_high_T = 0.01

  warn_when_large_rel_run_E_err = 1d99
  warning_limit_for_max_residual = 1d99
  max_abs_rel_run_E_err = 1d99

  varcontrol_target = 0.01

  convergence_ignore_equL_residuals = .true.

  limit_for_rel_error_in_energy_conservation = 1d99
  hard_limit_for_rel_error_in_energy_conservation = 1d99

  max_timestep = 1d-4       !For a Stripped progenitor

  ! solver controls

  solver_iters_timestep_limit = 20                !For a Stripped progenitor
  solver_max_tries_before_reject = 21             !For a Stripped progenitor
  iter_for_resid_tol2 = 20                         !For a Stripped progenitor
  tol_residual_norm1 = 1d-7                       !For a Stripped progenitor
  tol_max_residual1 = 1d-4                        !For a Stripped progenitor

  tiny_corr_coeff_limit = 999999                  !For a Stripped progenitor
  solver_itermin_until_reduce_min_corr_coeff = 999999         !For a Stripped progenitor
  max_resid_jump_limit = 1d99                     !For a Stripped progenitor
  convergence_ignore_equL_residuals = .true.


  ! TESTING -- NEED A WORKAROUND
  ! use_gold2_tolerances = .false.       !For a Stripped progenitor
  ! use_gold_tolerances = .false.        !For a Stripped progenitor
   

  photo_interval = 50
  profile_interval = 50
  history_interval = 10
  terminal_interval = 10

/ ! end of controls namelist

&pgstar
         
    ! Grid2_win_flag = .true.
    Grid2_title = 'CCSN (Edep)'
    ! pgstar_interval = 1

/ ! end of pgstar namelist
