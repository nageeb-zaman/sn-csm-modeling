
&star_job

  load_saved_model = .true.

  load_model_filename = '18M_to_4.7M_Collapsed_Core.mod'

  save_model_when_terminate = .true.
  save_model_filename = 'finished_infall.mod'
  ! required_termination_code_string = 'center_R_lower_limit'
  required_termination_code_string = 'max_model_number'     ! For a Stripped progenitor

  set_initial_age = .true.
  initial_age = 0
  
  set_initial_model_number = .true.
  initial_model_number = 0
  
  set_initial_dt = .true.
  seconds_for_initial_dt = 0.0001
      
  !set_initial_cumulative_energy_error = .true.     ! For a Stripped progenitor
  !new_cumulative_energy_error = 0d0                ! For a Stripped progenitor

  change_initial_v_flag = .true.
  change_initial_u_flag = .true.
  new_v_flag = .false.
  new_u_flag = .true.

  remove_initial_center_by_entropy =   4.0
  ! remove_initial_center_by_entropy =   3.3
  ! remove_initial_fe_core = .true.       ! For a Stripped progenitor
  ! remove_fe_core = .true.               ! For a Stripped progenitor


  remove_center_set_zero_v_center = .false.
  !remove_center_set_zero_v_center = .true.

  pgstar_flag = .true.

/ ! end of star_job namelist

&eos
/ ! end of eos namelist

&kap
      kap_file_prefix = 'gs98'
      !Zbase = 0.006d0
      use_Type2_opacities = .false.
/ ! end of kap namelist

&controls


  max_model_number = 200       
  when_to_stop_rtol = 0.0001
  when_to_stop_atol = 10000

  ! center_R_lower_limit = 2d+07
  ! center_R_lower_limit = 1.79d+08   !Nageeb
  fe_core_infall_limit = 1d+99
  calculate_Brunt_N2 = .false.

! equation controls
  use_dPrad_dm_form_of_T_gradient_eqn = .true.
  energy_eqn_option = 'dedt'
  use_fixed_vsurf_outer_BC = .true.
  fixed_vsurf = 0d0
  !dxdt_nuc_factor = 0        !For a Stripped progenitor
  !eps_nuc_factor = 0         !For a Stripped progenitor

! mixing controls
  mixing_length_alpha = 1.9
  !MLT_option = 'none'
  MLT_option = 'Henyey'
  thermohaline_coeff = 0
  okay_to_reduce_gradT_excess = .false.

! mesh controls
  okay_to_remesh = .false.

! timestep controls

  max_timestep = 0.05
  !varcontrol_target = 3d-4
  varcontrol_target = 1d-3

  dX_nuc_drop_limit_at_high_T = 0.01
  delta_lgL_He_limit = 0.5
  delta_lgT_cntr_limit = 0.2
  delta_lgRho_cntr_limit = 0.5

  !For a Stripped progenitor...........................
  !delta_XH_cntr_limit = 1d99
  !delta_XHe_cntr_limit = 1d99
  !delta_XC_cntr_limit = 1d99
  !delta_XO_cntr_limit = 1d99
  !delta_XNe_cntr_limit = 1d99
  !delta_XSi_cntr_limit = 1d99
  !delta_XH_cntr_hard_limit = -1d0
  !delta_XHe_cntr_hard_limit = -1d0
  !delta_XC_cntr_hard_limit = -1d0
  !delta_XO_cntr_hard_limit = -1d0
  !delta_XNe_cntr_hard_limit = -1d0
  !delta_XSi_cntr_hard_limit = -1d0
  !..................................................

  overshoot_D_min = 1d0    !For a Stripped progenitor

  limit_for_rel_error_in_energy_conservation = 1d99
  hard_limit_for_rel_error_in_energy_conservation = 1d99

! solver controls   

  solver_iters_timestep_limit = 8                !For a Stripped progenitor
  solver_max_tries_before_reject = 9             !For a Stripped progenitor
  iter_for_resid_tol2 = 8                         !For a Stripped progenitor
  tol_residual_norm1 = 1d-10                       !For a Stripped progenitor
  tol_max_residual1 = 1d-7                        !For a Stripped progenitor

  tiny_corr_coeff_limit = 999999                  !For a Stripped progenitor
  solver_itermin_until_reduce_min_corr_coeff = 999999         !For a Stripped progenitor
  

  convergence_ignore_equL_residuals = .true.

! output controls
  terminal_interval = 1 
  write_header_frequency = 10
  terminal_show_age_units = 'seconds'
  photo_interval = 10
  history_interval = 10
  profile_interval = 10
  max_num_profile_models = 1000

  warn_when_large_rel_run_E_err = 1d99
  warning_limit_for_max_residual = 1d99
  max_abs_rel_run_E_err = 1d99           ! energy accounting doesn't deal with nonzero v_center.
   
  num_trace_history_values = 3
  trace_history_value_name(1) = 'rel_E_err'
  trace_history_value_name(2) = 'log_rel_run_E_err'
  trace_history_value_name(3) = 'r_center_cm'

  !For a Stripped progenitor ......................
  he_core_boundary_h1_fraction = 0.5
  co_core_boundary_he4_fraction = 0.5
  one_core_boundary_he4_c12_fraction = 0.5
  !si_core_boundary_o16_fraction = 0.5
  fe_core_boundary_si28_fraction = 0.5
  !................................................

/ ! end of controls namelist

&pgstar
        
    !Grid2_win_flag = .true.
    Grid2_title = 'CCSN (Infall)'
    pgstar_interval = 1

/ ! end of pgstar namelist
